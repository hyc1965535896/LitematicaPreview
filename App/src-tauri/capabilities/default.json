{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local",
  "description": "Only the bundled main window can open and preview schematics.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "allow-bootstrap",
    "allow-choose-file",
    "allow-load-preview",
    "allow-start-preview",
    "allow-next-preview",
    "allow-read-preview",
    "allow-preview-memory",
    "allow-release-preview",
    "allow-cancel-load",
    "allow-register-associations",
    "allow-unregister-associations",
    "allow-show-licenses",
    "allow-export-schematic",
    "allow-block-catalog",
    "allow-block-icons"
  ]
}
