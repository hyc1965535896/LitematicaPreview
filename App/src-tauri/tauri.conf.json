{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Litematica Preview",
  "mainBinaryName": "LitematicaPreview",
  "version": "0.3.0",
  "identifier": "dev.litematica.preview",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Litematica Preview",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": ["main-local"],
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'none'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'",
      "devCsp": "default-src 'none'; script-src 'self' 'unsafe-inline'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; object-src 'none'; base-uri 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Offline Minecraft schematic viewer",
    "icon": ["../../Assets/app.ico", "../../Assets/icon.png"],
    "resources": {
      "../../Assets/pack.zip": "Assets/pack.zip",
      "../../Fixtures/Demos/": "Demos/",
      "../../LICENSE": "Licenses/LICENSE",
      "../../NOTICE": "Licenses/NOTICE",
      "../../ThirdParty/": "Licenses/ThirdParty/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "template": "../../scripts/installer.nsi",
        "installMode": "currentUser",
        "installerIcon": "../../Assets/app.ico",
        "installerHooks": "../../scripts/installer-hooks.nsh",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"]
      }
    }
  }
}
